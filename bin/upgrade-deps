#!/usr/bin/env bash
#
# Upgrade the locked dependencies of every project in a single branch:
# libs/, then src/, then the pnpm lock of the web front. One commit per project.
# Only lock files change: no version bump, since the pyproject.toml
# dependencies are left untouched and services consume libs as editable paths.
# Pushes the branch and returns to main.
#
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

BRANCH="chore/upgrade-deps"
LIBS=(libs/ddd libs/referentiel libs/scaleway_secrets)
SERVICES=(src/web src/ocr src/ingestion src/notebook)

if [ -n "$(git status --porcelain)" ]; then
  echo "✖ working tree is not clean; commit or stash your changes first" >&2
  exit 1
fi

git switch main
git pull --ff-only origin main

if git ls-remote --exit-code --heads origin "$BRANCH" > /dev/null 2>&1; then
  echo "✖ remote branch already exists, aborting: $BRANCH" >&2
  exit 1
fi

git switch -C "$BRANCH"
commits=0

abort_and_clean() {
  trap - ERR
  echo "✖ échec, retour sur main et suppression de la branche locale $BRANCH" >&2
  git reset --hard --quiet
  git switch --quiet main
  git branch -D "$BRANCH"
}
trap abort_and_clean ERR

upgrade_project() {
  local dir="$1" name="${1##*/}"
  echo "▶ [$name] mise à jour des dépendances"
  ( cd "$dir" && uv lock --upgrade )

  if git diff --quiet -- "$dir/uv.lock"; then
    echo "⚠ [$name] no dependency changes, skipping"
    return
  fi

  git add "$dir/uv.lock"
  git commit -m "build(tooling): met à jour les dépendances de $name"
  commits=$((commits + 1))
}

upgrade_pnpm() {
  local dir="src/web"
  echo "▶ [web-front] mise à jour des dépendances"
  ( cd "$dir" && pnpm update --no-save )

  if git diff --quiet -- "$dir/pnpm-lock.yaml"; then
    echo "⚠ [web-front] no dependency changes, skipping"
    return
  fi

  git add "$dir/pnpm-lock.yaml"
  git commit -m "build(tooling): met à jour les dépendances front de web"
  commits=$((commits + 1))
}

for dir in "${LIBS[@]}"; do
  upgrade_project "$dir"
done

for dir in "${SERVICES[@]}"; do
  upgrade_project "$dir"
done

upgrade_pnpm

if [ "$commits" -eq 0 ]; then
  echo "⚠ no dependency changes anywhere, removing $BRANCH"
  git switch main
  git branch -D "$BRANCH"
else
  trap - ERR
  git push -u origin "$BRANCH"
  git switch main
fi

echo "▶ Done."
