# JSON list of {"client_id", "client_secret", "base_url", "role"} objects.
# "front" credentials get an active TalentsoftFrontClient registered for
# import/archive calls; "back" credentials are only used to verify webhook
# signatures. Add as many entries as needed.
TALENTSOFT_CREDENTIALS=[]

# API key sent as X-API-Key when calling the GIPCDG collectivités endpoint
# (emploi-territorial.fr) for the organismes import.
GIPCDG_API_KEY=

# Endpoint used to fetch collectivités for the GIPCDG organismes import.
# Defaults to https://emploi-territorial.fr/api/cdg/collectivites?etab=5&limit=1000
# GIPCDG_COLLECTIVITES_API_URL=

WEB_BASE_URL=
WEB_API_KEY=

DATABASE_URL=psql://ingestion:pass@localhost:5432/ingestion
TEST_DATABASE_URL=psql://ingestion:pass@localhost:5432/ingestion_test
REDIS_URL=redis://localhost:6379/1

FLOWER_BASIC_AUTH_USER=flower
FLOWER_BASIC_AUTH_PASSWORD=flower
FLOWER_PORT=5555
