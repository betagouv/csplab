{
  "name": "csplab-frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/build-icons.mjs --check",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-types": "openapi-typescript ../presentation/static/api/internal-schema.yaml -o src/types/api.d.ts",
    "icons": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "^2.0.0",
    "@iconify/vue": "^5.0.1",
    "@pinia/colada": "^1.4.2",
    "@sentry/vue": "^10.70.0",
    "@tanstack/vue-table": "^8.21.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.4",
    "reka-ui": "~2.9.10",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@iconify-icons/ri": "^1.2.10",
    "@pinia/colada-devtools": "^1.1.2",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/vue3": "^10.5.8",
    "@storybook/vue3-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-storybook": "^10.5.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.10",
    "vue-component-meta": "^3.3.10",
    "vue-tsc": "^3.3.10"
  }
}
