{
  "name": "csplab-web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p frontend && vite build",
    "typecheck": "vue-tsc --noEmit -p frontend",
    "preview": "vite preview",
    "lint": "eslint . && node frontend/scripts/build-icons.mjs --check",
    "lint:fix": "eslint . --fix",
    "lint:candidate-js": "eslint \"presentation/static/candidate/js/**/*.js\"",
    "lint:candidate-js:fix": "eslint \"presentation/static/candidate/js/**/*.js\" --fix",
    "lint:styles": "eslint \"presentation/assets/styles/**/*.scss\"",
    "lint:styles:fix": "eslint \"presentation/assets/styles/**/*.scss\" --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -c frontend/.storybook -p 6006",
    "build-storybook": "storybook build -c frontend/.storybook -o frontend/storybook-static",
    "generate-types": "openapi-typescript presentation/static/api/internal-schema.yaml -o frontend/src/types/api.d.ts",
    "icons": "node frontend/scripts/build-icons.mjs",
    "icons:check": "node frontend/scripts/build-icons.mjs --check"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "^2.1.0",
    "@iconify/vue": "^5.0.5",
    "@pinia/colada": "^1.4.9",
    "@sentry/vue": "^10.78.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unhead/vue": "^3.4.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.4",
    "reka-ui": "~2.9.10",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-icons/ri": "^1.2.11",
    "@pinia/colada-devtools": "^1.1.2",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^29.1.1",
    "msw": "^3.0.4",
    "openapi-msw": "^2.1.1",
    "openapi-typescript": "^7.13.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.107.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.12",
    "vue-component-meta": "^3.3.14",
    "vue-tsc": "^3.3.14"
  }
}
